    "test": "vp test run",
    "test:watch": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "h3": "^1.15.11",
    "happy-dom": "^20.11.0",
    "nitropack": "^2.13.4",
    "nuxt": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
