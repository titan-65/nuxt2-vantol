    "ai-assistant",
    "assistant",
    "chat",
    "command-palette",
    "nuxt",
    "nuxt-module",
    "portfolio"
  ],
  "homepage": "https://github.com/titan-65/nuxt2-vantol/tree/main/packages/assistant#readme",
  "bugs": {
    "url": "https://github.com/titan-65/nuxt2-vantol/issues"
  },
  "license": "MIT",
  "author": "Vantol Bennett <vantolbennettclm@gmail.com> (https://vantolbennett.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/titan-65/nuxt2-vantol.git",
    "directory": "packages/assistant"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
