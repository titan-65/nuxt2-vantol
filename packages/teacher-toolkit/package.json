{
  "name": "@vvantol2000/teacher-toolkit",
  "version": "1.0.1",
  "description": "Grade calculation utilities for teachers",
  "keywords": [
    "education",
    "gpa",
    "gradebook",
    "grading",
    "scores",
    "teacher"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/titan-65/nuxt2-vantol",
    "directory": "packages/teacher-toolkit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.1.0"
  }
}
