{
  "name": "nuxt-presence",
  "version": "0.1.0",
  "description": "A signed guestbook visitors can leave their mark on, with avatar + handle, an ed25519 build mark, and a token-gated admin tab.",
  "keywords": [
    "admin-tab",
    "ed25519",
    "guestbook",
    "moderation",
    "nuxt",
    "nuxt-module",
    "presence",
    "rate-limit",
    "signing",
    "social-pull"
  ],
  "homepage": "https://github.com/titan-65/nuxt2-vantol/tree/main/packages/presence#readme",
  "bugs": {
    "url": "https://github.com/titan-65/nuxt2-vantol/issues"
  },
  "license": "MIT",
  "author": "Vantol Bennett <vantolbennettclm@gmail.com> (https://vantolbennett.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/titan-65/nuxt2-vantol.git",
    "directory": "packages/presence"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    },
    "./runtime/server/storage": {
      "types": "./dist/runtime/server/storage/index.d.ts",
      "import": "./dist/runtime/server/storage/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepare": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "test": "vp test run",
    "test:watch": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "h3": "^1.15.11",
    "happy-dom": "^20.11.0",
    "nitropack": "^2.13.4",
    "nuxt": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
