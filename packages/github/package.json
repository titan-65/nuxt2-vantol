{
  "name": "@nuxt-presence/github",
  "version": "0.1.0",
  "description": "GitHub OAuth identity resolver companion for nuxt-presence. Provides avatar + handle from GitHub, optional social-pull on followers/following.",
  "keywords": [
    "github",
    "guestbook",
    "identity",
    "nuxt",
    "nuxt-module",
    "oauth",
    "presence",
    "social-pull"
  ],
  "license": "MIT",
  "author": "Vantol Bennett <vantolbennettclm@gmail.com> (https://vantolbennett.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/titan-65/nuxt2-vantol.git",
    "directory": "packages/github"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepare": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "check": "vp check"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0",
    "nuxt-presence": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "h3": "^1.15.11",
    "nitropack": "^2.13.4",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
