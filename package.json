{
  "name": "vantolbennett-monorepo",
  "private": true,
  "type": "module",
  "devDependencies": {
    "vite-plus": "^0.1.14"
  },
  "scripts": {
    "dev": "pnpm --filter @vvantol2000/web dev",
    "generate": "pnpm --filter @vvantol2000/web generate",
    "preview": "pnpm --filter @vvantol2000/web preview",
    "test": "pnpm -r run test",
    "pack:toolkit": "pnpm --filter @vvantol2000/teacher-toolkit pack",
    "pack:env-check": "pnpm --filter @vvantol2000/env-check build",
    "pack:deploy-hooks": "pnpm --filter @vvantol2000/vercel-deploy-hooks build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "keytar",
      "better-sqlite3",
      "esbuild",
      "sharp"
    ],
    "patchedDependencies": {
      "@voidzero-dev/vite-plus-core@0.1.16-alpha.0": "patches/@voidzero-dev__vite-plus-core@0.1.16-alpha.0.patch"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "protobufjs",
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "version": "0.0.1"
}
