use provider

use std.io

use std.fmt

use std.str

use std.mem

pub fn openai_build_request(buf: MutSpan<u8>, req: ProviderRequest, api_key: String) -> Maybe<Span<u8>> {
    var body_buf: [8192]u8 = [0_u8; 8192]
    let body: Maybe<Span<u8>> = openai_build_body(body_buf, req)
    if !body.has {
        return null
    }
    let body_len: usize = std.mem.len(body.value)
    var body_len_str_buf: [12]u8 = [0_u8; 12]
    let body_len_str: Maybe<Span<u8>> = std.fmt.usize(body_len_str_buf, body_len)
    if !body_len_str.has {
        return null
    }
    var off: usize = 0
    let o1: Maybe<usize> = std.io.writeSpan(buf, off, "POST https://api.openai.com/v1/chat/completions HTTP/1.1\r\n")
    if !o1.has {
        return null
    }
    off = o1.value
    let o2: Maybe<usize> = std.io.writeSpan(buf, off, "host: api.openai.com\r\n")
    if !o2.has {
        return null
    }
    off = o2.value
    let o3: Maybe<usize> = std.io.writeSpan(buf, off, "content-type: application/json\r\n")
    if !o3.has {
        return null
    }
    off = o3.value
    let o4: Maybe<usize> = std.io.writeSpan(buf, off, "authorization: Bearer ")
    if !o4.has {
        return null
    }
    off = o4.value
    let o5: Maybe<usize> = std.io.writeSpan(buf, off, api_key)
    if !o5.has {
        return null
    }
    off = o5.value
    let o6: Maybe<usize> = std.io.writeSpan(buf, off, "\r\n")
    if !o6.has {
        return null
    }
    off = o6.value
    let o7: Maybe<usize> = std.io.writeSpan(buf, off, "content-length: ")
    if !o7.has {
        return null
    }
    off = o7.value
    let o8: Maybe<usize> = std.io.writeSpan(buf, off, body_len_str.value)
    if !o8.has {
        return null
    }
    off = o8.value
    let o9: Maybe<usize> = std.io.writeSpan(buf, off, "\r\n\r\n")
    if !o9.has {
        return null
    }
    off = o9.value
    let o10: Maybe<usize> = std.io.writeSpan(buf, off, body.value)
    if !o10.has {
        return null
    }
    off = o10.value
    return std.mem.prefix(buf, off)
}

fn openai_build_body(buf: MutSpan<u8>, req: ProviderRequest) -> Maybe<Span<u8>> {
    var off: usize = 0
    let o1: Maybe<usize> = std.io.writeSpan(buf, off, "{\"model\":\"")
    if !o1.has {
        return null
    }
    off = o1.value
    let o2: Maybe<usize> = std.io.writeSpan(buf, off, req.model)
    if !o2.has {
        return null
    }
    off = o2.value
    let o3: Maybe<usize> = std.io.writeSpan(buf, off, "\",\"max_tokens\":")
    if !o3.has {
        return null
    }
    off = o3.value
    var max_buf: [12]u8 = [0_u8; 12]
    let max_str: Maybe<Span<u8>> = std.fmt.u32(max_buf, req.max_tokens)
    if !max_str.has {
        return null
    }
    let o4: Maybe<usize> = std.io.writeSpan(buf, off, max_str.value)
    if !o4.has {
        return null
    }
    off = o4.value
    let o5: Maybe<usize> = std.io.writeSpan(buf, off, ",\"messages\":[")
    if !o5.has {
        return null
    }
    off = o5.value
    if std.mem.len(req.system) > 0_usize {
        let o6: Maybe<usize> = std.io.writeSpan(buf, off, "{\"role\":\"system\",\"content\":\"")
        if !o6.has {
            return null
        }
        off = o6.value
        let o7: Maybe<usize> = std.io.writeSpan(buf, off, req.system)
        if !o7.has {
            return null
        }
        off = o7.value
        let o8: Maybe<usize> = std.io.writeSpan(buf, off, "\"}")
        if !o8.has {
            return null
        }
        off = o8.value
        if std.mem.len(req.messages_json) > 2_usize {
            let o9: Maybe<usize> = std.io.writeSpan(buf, off, ",")
            if !o9.has {
                return null
            }
            off = o9.value
        }
    }
    if std.mem.len(req.messages_json) >= 2_usize {
        let inner: Span<u8> = std.mem.prefix(std.mem.dropPrefix(req.messages_json, 1_usize), std.mem.len(req.messages_json) - 2_usize)
        let o10: Maybe<usize> = std.io.writeSpan(buf, off, inner)
        if !o10.has {
            return null
        }
        off = o10.value
    }
    let o11: Maybe<usize> = std.io.writeSpan(buf, off, "],\"tools\":")
    if !o11.has {
        return null
    }
    off = o11.value
    let o12: Maybe<usize> = std.io.writeSpan(buf, off, req.tools_json)
    if !o12.has {
        return null
    }
    off = o12.value
    let o13: Maybe<usize> = std.io.writeSpan(buf, off, "}")
    if !o13.has {
        return null
    }
    off = o13.value
    return std.mem.prefix(buf, off)
}

pub fn openai_parse_response(body: String, status: u16) -> ProviderOutcome {
    if status != 200_u16 {
        return ProviderOutcome.err(ProviderError.http(HttpDetail { status: status, body: body }))
    }
    let marker: Span<u8> = "\"content\":\""
    let marker_idx: usize = std.str.indexOf(body, marker)
    if marker_idx == 0_usize {
        return ProviderOutcome.ok(ProviderResponse { text: "", tool_calls_json: "[]", stop_reason: "stop" })
    }
    let value_off: usize = marker_idx + 11_usize
    let blen: usize = std.mem.len(body)
    var end: usize = value_off
    var i: usize = value_off
    while i < blen {
        let b: Maybe<u8> = std.mem.get(body, i)
        if b.has {
            if b.value == 0x22_u8 {
                end = i
                i = blen
            } else {
                i = i + 1_usize
            }
        } else {
            i = blen
        }
    }
    let after: Span<u8> = std.mem.dropPrefix(body, value_off)
    let text_value: Span<u8> = std.mem.prefix(after, end - value_off)
    return ProviderOutcome.ok(ProviderResponse { text: text_value, tool_calls_json: "[]", stop_reason: "stop" })
}
