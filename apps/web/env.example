# GitHub OAuth for Nuxt Studio
STUDIO_GITHUB_CLIENT_ID=your_client_id_here
STUDIO_GITHUB_CLIENT_SECRET=your_client_secret_here

# Firebase Configuration
NUXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NUXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NUXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
NUXT_PUBLIC_ADMIN_EMAILS=your-admin@email.com

# Site URL for RSS/sitemap generation
NUXT_PUBLIC_SITE_URL=https://vantolbennett.com

# Better Auth + GitHub OAuth for nuxt-presence
NUXT_PRESENCE_GITHUB_CLIENT_ID=your_github_oauth_app_id
NUXT_PRESENCE_GITHUB_CLIENT_SECRET=your_github_oauth_app_secret
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth callback: http://localhost:3000/api/auth/callback/github
